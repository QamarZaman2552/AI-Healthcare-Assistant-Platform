{
  "info": {
    "_postman_id": "ai-healthcare-assistant",
    "name": "AI Healthcare Assistant Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\":\"test@example.com\",\"password\":\"Password123!\",\"role\":\"Patient\",\"firstName\":\"John\",\"lastName\":\"Doe\",\"phoneNumber\":\"+923001234567\"}"},
            "url": {"raw": "{{baseUrl}}/api/auth/register", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "auth", "register"]}
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\":\"test@example.com\",\"password\":\"Password123!\"}"},
            "url": {"raw": "{{baseUrl}}/api/auth/login", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "auth", "login"]}
          }
        }
      ]
    },
    {
      "name": "Availability",
      "item": [
        {
          "name": "Get All by Doctor",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/availability/doctor/{{doctorId}}", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "availability", "doctor", "{{doctorId}}"]}
          }
        },
        {
          "name": "Get by Doctor and Day",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/availability/doctor/{{doctorId}}/day/{{dayOfWeek}}", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "availability", "doctor", "{{doctorId}}", "day", "{{dayOfWeek}}"]}
          }
        },
        {
          "name": "Get Available Slots",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/availability/doctor/{{doctorId}}/slots/{{date}}", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "availability", "doctor", "{{doctorId}}", "slots", "{{date}}"]}
          }
        },
        {
          "name": "Search Available Doctors",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/availability/search?specialtyId={{specialtyId}}&date={{date}}", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "availability", "search"]}
          }
        },
        {
          "name": "Create Availability",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "raw", "raw": "{\"doctorId\":\"{{doctorId}}\",\"dayOfWeek\":\"Monday\",\"startTime\":\"09:00\",\"endTime\":\"17:00\",\"slotDurationMinutes\":30}"},
            "url": {"raw": "{{baseUrl}}/api/availability", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "availability"]}
          }
        },
        {
          "name": "Delete Availability",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/availability/{{id}}", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "availability", "{{id}}"]}
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Get by ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/appointments/{{id}}", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "appointments", "{{id}}"]}
          }
        },
        {
          "name": "Get by Patient",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/appointments/patient/{{patientId}}", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "appointments", "patient", "{{patientId}}"]}
          }
        },
        {
          "name": "Get by Doctor",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/appointments/doctor/{{doctorId}}", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "appointments", "doctor", "{{doctorId}}"]}
          }
        },
        {
          "name": "Create Appointment",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "raw", "raw": "{\"patientId\":\"{{patientId}}\",\"doctorId\":\"{{doctorId}}\",\"scheduledStart\":\"2026-09-20T10:00:00\",\"scheduledEnd\":\"2026-09-20T11:00:00\",\"reasonForVisit\":\"General checkup\"}"},
            "url": {"raw": "{{baseUrl}}/api/appointments", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "appointments"]}
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/appointments/{{id}}/cancel?cancellationReason=Patient request", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "appointments", "{{id}}", "cancel"]}
          }
        },
        {
          "name": "Reschedule Appointment",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "raw", "raw": "{\"newScheduledStart\":\"2026-09-22T10:00:00\",\"newScheduledEnd\":\"2026-09-22T11:00:00\"}"},
            "url": {"raw": "{{baseUrl}}/api/appointments/{{id}}/reschedule", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "appointments", "{{id}}", "reschedule"]}
          }
        },
        {
          "name": "Update Status",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/appointments/{{id}}/status?status=Confirmed", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "appointments", "{{id}}", "status"]}
          }
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Chat",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "raw", "raw": "{\"message\":\"I have a headache\"}"},
            "url": {"raw": "{{baseUrl}}/api/ai/chat", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "ai", "chat"]}
          }
        },
        {
          "name": "Symptom Check",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "raw", "raw": "{\"symptoms\":[\"headache\",\"fever\"]}"},
            "url": {"raw": "{{baseUrl}}/api/ai/symptom-check", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "ai", "symptom-check"]}
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/ai/health", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "ai", "health"]}
          }
        }
