          }
        },
        {
          "name": "Create Doctor",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "raw", "raw": "{\"userId\":\"{{userId}}\",\"licenseNumber\":\"LIC123\",\"yearsOfExperience\":5,\"consultationFee\":100,\"clinicName\":\"Test Clinic\",\"clinicAddress\":\"123 Main St\"}"},
            "url": {"raw": "{{baseUrl}}/api/doctors", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "doctors"]}
          }
        },
        {
          "name": "Update Doctor",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "raw", "raw": "{\"licenseNumber\":\"LIC456\",\"yearsOfExperience\":10}"},
            "url": {"raw": "{{baseUrl}}/api/doctors/{{id}}", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "doctors", "{{id}}"]}
          }
        },
        {
          "name": "Update Status",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/doctors/{{id}}/status", "protocol": "http", "host": [{{baseUrl}}], "path": ["api", "doctors", "{{id}}", "status"]}
          }
        }
